{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "microphone=(self \"*\"), camera=(), geolocation=()"
        },
        {
          "key": "Feature-Policy",
          "value": "microphone *"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' 'unsafe-inline' 'unsafe-eval' https: blob: data:; connect-src 'self' https: wss: ws: https://*.googleapis.com https://*.run.app; media-src 'self' blob: data: https:; img-src 'self' data: blob: https:;"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ]
}
