<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Handle WhatsApp / Facebook OpenGraph previews if slip.php is present
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|WhatsApp|Twitterbot|LinkedInBot|TelegramBot) [NC]
  RewriteCond %{REQUEST_URI} ^/slip/([^/]+)/?$
  RewriteCond %{DOCUMENT_ROOT}/slip.php -f
  RewriteRule ^slip/([^/]+)/?$ /slip.php?id=$1 [L,QSA]

  # Map /api/slips to /api/slips.php if PHP is present
  RewriteCond %{DOCUMENT_ROOT}/api/slips.php -f
  RewriteRule ^api/slips/?$ /api/slips.php [L,QSA]

  # Allow direct access to real files and folders
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Rewrite all /slip/... routes to index.html
  RewriteRule ^slip/.*$ /index.html [L,QSA]

  # All other routes to index.html for Single Page Application routing
  RewriteRule . /index.html [L]
</IfModule>

# Browser Caching & Compression for Fast Loading
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  Header set Access-Control-Allow-Origin "*"
</IfModule>
