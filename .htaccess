<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Disable cache for HTML and SW so updates take effect immediately
  <FilesMatch "^(index\.(html|php)|sw\.js)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>

  # Route WhatsApp / Social crawlers to slip.php
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|WhatsApp|Twitterbot|LinkedInBot|TelegramBot) [NC]
  RewriteCond %{REQUEST_URI} ^/slip/([^/]+)/?$
  RewriteCond %{DOCUMENT_ROOT}/dist/slip.php -f
  RewriteRule ^slip/([^/]+)/?$ /dist/slip.php?id=$1 [L,QSA]

  # Route /api/slips
  RewriteCond %{DOCUMENT_ROOT}/dist/api/slips.php -f
  RewriteRule ^api/slips/?$ /dist/api/slips.php [L,QSA]

  # Route /api/users-sync
  RewriteCond %{DOCUMENT_ROOT}/dist/api/users.php -f
  RewriteRule ^api/users-sync/?$ /dist/api/users.php [L,QSA]

  # Serve dist files if they exist
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/dist%{REQUEST_URI} -f
  RewriteRule ^(.*)$ /dist/$1 [L]

  # Route /adil
  RewriteCond %{DOCUMENT_ROOT}/dist/index.html -f
  RewriteRule ^adil/?$ /dist/index.html [L,QSA]

  # Fallback to dist/index.html or index.php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/dist/index.html -f
  RewriteRule . /dist/index.html [L]
</IfModule>

# Browser Caching & Compression for Static Assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType font/ttf "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  Header set Access-Control-Allow-Origin "*"
</IfModule>
