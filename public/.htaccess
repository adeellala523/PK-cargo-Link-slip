<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Map /api/slips and /api/slips/:id to api/slips.php
  RewriteRule ^api/slips(?:/([^/]+))?/?$ api/slips.php?id=$1 [L,QSA]

  # Map /api/users-sync to /api/users.php
  RewriteRule ^api/users-sync/?$ api/users.php [L,QSA]

  # Map /api/upload to /api/upload.php
  RewriteRule ^api/upload/?$ api/upload.php [L,QSA]

  # Map /api/whatsapp-webhook to /api/whatsapp-webhook.php
  RewriteRule ^api/whatsapp-webhook/?$ api/whatsapp-webhook.php [L,QSA]

  # Map /api/slip-image to /api/slip-image.php
  RewriteRule ^api/slip-image/?$ api/slip-image.php [L,QSA]

  # Always route /slip/... to slip.php so Adda Name, Logo & Load Details are dynamically injected for WhatsApp and Browsers
  RewriteRule ^slip/([^/]+)/?$ slip.php?id=$1 [L,QSA]

  # Rewrite admin route /adil, driver portal /driver, and content pages
  RewriteRule ^(adil|driver|about|contact|privacy)/?$ /index.html [L,QSA]

  # Allow direct access to real files and folders
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Fallback all /slip/... routes to index.html if slip.php not present
  RewriteRule ^slip/.*$ /index.html [L,QSA]

  # All other routes to index.html for Single Page Application routing
  RewriteRule . /index.html [L]
</IfModule>

# Browser Caching & Compression for Fast Loading
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  Header set Access-Control-Allow-Origin "*"
</IfModule>
